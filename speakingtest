                <div className="text-center py-24 space-y-8 flex-1 flex flex-col justify-center animate-pulse items-center">
                  <Loader2 className="w-20 h-20 text-indigo-600 animate-spin"/>
                  <h2 className="text-2xl font-black uppercase tracking-widest text-slate-800">AI Scoring in Progress...</h2>
                  <p className="text-lg text-slate-400 font-bold">B1.5評価基準に基づいて詳細な採点を行っています。</p>
                </div>
              )}
              
              {section.id === 'complete' && (
                <div className="text-center py-20 space-y-10 flex-1 flex flex-col justify-center items-center animate-in zoom-in-95">
                  <div className="w-24 h-24 bg-green-100 rounded-3xl flex items-center justify-center text-green-600 shadow-xl border-4 border-white"><CheckCircle size={56}/></div>
                  <h2 className="text-4xl font-black text-slate-800">提出完了</h2>
                  <p className="text-slate-500 text-xl font-bold">お疲れ様でした。解答は無事に送信されました。</p>
                  <div className="pt-12 flex flex-col gap-5 border-t w-full max-w-sm">
                    <button onClick={() => setView('teacher-login')} className="text-slate-300 hover:text-indigo-600 px-6 py-2 text-[11px] font-black transition-all flex items-center gap-1.5 mx-auto underline uppercase tracking-[0.2em]"><Lock size={14}/> Teacher Admin Access</button>
                  </div>
                </div>
              )}
            </div>
          )}

          {/* TEACHER DASHBOARD VIEWS */}
          {view === 'teacher-login' && (
            <div className="max-w-md mx-auto py-24 text-center space-y-10 flex-1 flex flex-col justify-center items-center animate-in slide-in-from-bottom-8">
               <div className="bg-slate-100 p-8 rounded-[2.5rem] shadow-inner text-indigo-600"><Lock size={64}/></div>
               <h2 className="text-3xl font-black tracking-widest uppercase">Admin Login</h2>
               <div className="space-y-6 w-full px-8">
                 <input type="password" className="w-full p-6 rounded-3xl border-4 border-slate-100 text-center text-5xl font-black bg-slate-50 outline-none focus:border-indigo-600 tracking-[0.5em] shadow-inner" placeholder="••••" value={passcode} onChange={(e) => setPasscode(e.target.value)}/>
                 <button onClick={() => passcode === TEACHER_PASSCODE ? setView('teacher-dashboard') : setError("パスコードが違います。")} className="w-full bg-indigo-600 text-white py-5 rounded-2xl font-black shadow-2xl text-2xl hover:bg-indigo-700 transition-all active:scale-95 tracking-widest">LOGIN</button>
                 <button onClick={() => setView('student')} className="text-slate-400 font-bold underline text-sm uppercase tracking-tighter hover:text-slate-600">Cancel</button>
               </div>
            </div>
          )}

          {view === 'teacher-dashboard' && (
            <div className="space-y-6 animate-in fade-in duration-300 flex-1 flex flex-col">
              <div className="flex justify-between items-center bg-indigo-900 p-5 rounded-3xl text-white shadow-2xl border-4 border-indigo-800">
                <div className="flex items-center gap-4">
                  <div className="p-2 bg-white/10 rounded-2xl"><Users size={24}/></div>
                  <h2 className="text-lg font-black tracking-tight uppercase">Teacher Portal Dashboard</h2>
                </div>
                <div className="flex gap-3">
                  <button onClick={() => setIsTeacherListView(!isTeacherListView)} className="bg-indigo-700 hover:bg-indigo-600 px-4 py-2 rounded-lg font-bold flex items-center gap-2 transition-all text-[11px] shadow-sm">{isTeacherListView ? <Eye size={12}/> : <FileSpreadsheet size={12}/>} {isTeacherListView ? "Student Detail" : "Ranking List"}</button>
                  <button onClick={() => setView('student')} className="bg-white/10 px-4 py-2 rounded-lg font-bold text-[11px] hover:bg-white/20">Logout</button>
                </div>
              </div>

              {isTeacherListView ? (
                <div className="bg-white border-4 border-slate-100 rounded-3xl overflow-hidden shadow-2xl flex-1 flex flex-col">
                  <div className="p-5 bg-slate-50 border-b-2 flex justify-between items-center text-slate-700">
                    <h3 className="font-black text-lg uppercase tracking-wider">Ranking Table</h3>
                  </div>
                  <div className="overflow-x-auto flex-1">
                    <table className="w-full text-left text-[11px] border-collapse">
                      <thead className="bg-slate-100 font-black uppercase text-slate-500 tracking-wider sticky top-0">
                        <tr className="border-b-2 border-slate-200">
                          <th className="p-4 w-16">Rank</th>
                          <th className="p-4">Student ID</th>
                          <th className="p-4 text-center">P1(6)</th>
                          <th className="p-4 text-center">P2(8)</th>
                          <th className="p-4 text-center">WPM</th>
                          <th className="p-4 text-center">P3(6)</th>
                          <th className="p-4 text-center">W(10)</th>
                          <th className="p-4 text-center font-black text-indigo-600 bg-indigo-50/50">Total</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y-2 divide-slate-50">
                        {submissions.map((sub, idx) => (
                          <tr key={sub.id} className="hover:bg-indigo-50/40 cursor-pointer transition-colors group" onClick={() => { setSelectedSubmission(sub); setIsTeacherListView(false); }}>
                            <td className="p-4 font-black text-slate-400 group-hover:text-indigo-600">{idx+1}</td>
                            <td className="p-4 font-black text-slate-700">{sub.studentId}</td>
                            <td className="p-4 text-center">{sub.evaluation.p1Score}</td>
                            <td className="p-4 text-center font-bold">{sub.evaluation.p2Score}</td>
                            <td className="p-4 text-center font-black text-green-600">{sub.evaluation.p2Wpm}</td>
                            <td className="p-4 text-center">{sub.evaluation.p3Score}</td>
                            <td className="p-4 text-center">{sub.evaluation.writingScore}</td>
                            <td className="p-4 text-center font-black text-lg text-indigo-600 bg-indigo-50/20">{sub.evaluation.totalScore}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              ) : (
                <div className="grid grid-cols-1 lg:grid-cols-4 gap-6 flex-1 min-h-0">
                  {/* Left List */}
                  <div className="lg:col-span-1 space-y-2 overflow-y-auto pr-2 custom-scrollbar">
                    {submissions.map((sub, idx) => (
                      <button key={sub.id} onClick={() => setSelectedSubmission(sub)} className={`w-full text-left p-4 rounded-2xl border-2 transition-all flex items-center gap-3 ${selectedSubmission?.id === sub.id ? 'bg-indigo-600 text-white border-indigo-600 shadow-xl scale-[1.02] z-10' : 'bg-white hover:border-indigo-300 shadow-sm'}`}>
                        <div className={`w-7 h-7 rounded-full flex items-center justify-center font-black text-[10px] ${selectedSubmission?.id === sub.id ? 'bg-white text-indigo-600' : 'bg-slate-100 text-slate-400'}`}>{idx+1}</div>
                        <div className="flex-1 min-w-0">
                           <p className="font-black truncate text-[11px] uppercase tracking-tighter">{sub.studentId.split('@')[0]}</p>
                           <p className={`text-[9px] opacity-60 font-bold`}>{new Date(sub.timestamp?.seconds * 1000).toLocaleTimeString()}</p>
                        </div>
                        <div className="text-right font-black text-[14px]">
                           <span>{sub.evaluation.totalScore}</span>
                        </div>
                      </button>
                    ))}
                  </div>

                  {/* Right Detail */}
                  <div className="lg:col-span-3 overflow-y-auto pr-1 flex flex-col">
                    {selectedSubmission ? (
                      <div className="bg-white rounded-[2rem] border-4 border-slate-100 p-8 space-y-8 shadow-2xl animate-in slide-in-from-right-12">
                        <div className="flex justify-between items-center border-b-4 border-slate-50 pb-8">
                          <div>
                            <h3 className="text-2xl font-black leading-none uppercase tracking-tight text-slate-800">Analytical Performance</h3>
                            <p className="text-[12px] text-slate-400 font-bold mt-2 flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-full border self-start"><Mail size={14}/> {selectedSubmission.studentId}</p>
                          </div>
                          <div className="bg-indigo-600 text-white px-10 py-6 rounded-[2rem] text-center shadow-xl border-4 border-indigo-400">
                             <div className="text-6xl font-black">{selectedSubmission.evaluation.totalScore}<span className="text-2xl opacity-50 ml-2">/30</span></div>
                             <p className="text-[10px] font-black uppercase tracking-[0.3em] mt-3">Overall CEFR B1.5 Grade</p>
                          </div>
                        </div>

                        <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                          {[
                            { title: "Speaking 1: 音読", score: selectedSubmission.evaluation.p1Score, max: 6, rat: selectedSubmission.evaluation.p1Rationale, trans: selectedSubmission.transcripts['speaking-1'] },
                            { title: "Speaking 2: イラスト描写", score: selectedSubmission.evaluation.p2Score, max: 8, rat: selectedSubmission.evaluation.p2Rationale, wpm: selectedSubmission.evaluation.p2Wpm, trans: selectedSubmission.transcripts['speaking-2'] },
                            { title: "Speaking 3: Q&A", score: selectedSubmission.evaluation.p3Score, max: 6, rat: selectedSubmission.evaluation.p3Rationale, trans: selectedSubmission.transcripts['speaking-3'] },
                            { title: "Writing: エッセイ", score: selectedSubmission.evaluation.writingScore, max: 10, rat: selectedSubmission.evaluation.writingRationale, essay: selectedSubmission.writingContent }
                          ].map((item, i) => (
                            <div key={i} className="p-6 bg-slate-50 rounded-[2.5rem] border border-slate-200 flex flex-col shadow-sm transition-all hover:shadow-md">
                              <div className="flex justify-between font-black mb-4 items-center">
                                <span className="text-indigo-900 text-[13px] uppercase tracking-tighter flex items-center gap-2">
                                  {i < 3 ? <Mic size={14}/> : <PenTool size={14}/>} {item.title}
                                </span>
                                <span className="text-indigo-600 font-black text-xl bg-white px-4 py-1.5 rounded-2xl border-2 shadow-inner">{item.score} / {item.max}</span>
                              </div>
                              
                              {item.wpm && <div className="text-[11px] font-black text-green-600 mb-4 bg-green-50 px-4 py-1.5 rounded-full inline-block border-2 border-green-100 shadow-sm self-start flex items-center gap-1.5"><Award size={12}/> Speaking Speed: {item.wpm} WPM</div>}
                              
                              <div className="mb-5">
                                <p className="text-[10px] font-black text-slate-400 uppercase tracking-tighter mb-2 border-b pb-1">Response Content / Transcription</p>
                                <div className="text-[12px] text-slate-600 italic leading-relaxed bg-white/90 p-4 rounded-2xl border border-slate-100 max-h-48 overflow-y-auto font-medium shadow-inner">
                                  "{item.essay || item.trans || "(No recorded response)"}"
                                </div>
                              </div>
                              
                              <div className="mt-auto bg-white/40 p-4 rounded-2xl border border-indigo-50">
                                <p className="text-[10px] text-indigo-400 font-black uppercase tracking-tighter mb-2 flex items-center gap-1.5"><ClipboardList size={12}/> AI Assessment Rationale</p>
                                <p className="text-[12px] text-slate-600 leading-snug font-bold border-l-4 border-indigo-200 pl-4">{item.rat}</p>
                              </div>
                            </div>
                          ))}
                        </div>

                        <div className="p-8 bg-slate-900 rounded-[3rem] text-white shadow-2xl border-4 border-slate-800 relative overflow-hidden">
                           <div className="absolute top-0 right-0 p-12 opacity-10 text-indigo-400 rotate-12"><BarChart3 size={150}/></div>
                           <h4 className="text-[12px] font-black text-indigo-400 uppercase tracking-[0.4em] mb-4 flex items-center gap-2 relative z-10"><Award size={16}/> Summary Recommendations</h4>
                           <p className="text-[15px] italic leading-relaxed text-slate-200 font-medium relative z-10">"{selectedSubmission.evaluation.feedback}"</p>
                        </div>
                      </div>
                    ) : (
                      <div className="h-full flex items-center justify-center text-slate-300 border-8 border-dashed rounded-[5rem] min-h-[500px] bg-slate-50/50 flex-col gap-6">
                         <BarChart3 size={120} strokeWidth={1} className="opacity-20 animate-pulse"/>
                         <p className="uppercase font-black text-sm tracking-[0.5em] opacity-40">Select student to view detail</p>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
